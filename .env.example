# =============================================================================
# NEXA Wallet — Environment Configuration (EXAMPLE)
# Pay Smart. Stay Protected.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local docker-compose maps Postgres to host port 5433
DATABASE_URL="postgresql://nexa:nexa_password@localhost:5433/nexa_wallet?schema=public"

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Auth / JWT -------------------------------------------------------------
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Encryption -------------------------------------------------------------
# 32-byte hex key used to encrypt TOTP secrets at rest (AES-256-GCM)
ENCRYPTION_KEY=replace_with_64_hex_characters_0000000000000000000000000000000000

# --- Account security -------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Email (optional; console transport used if unset) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NEXA Wallet <no-reply@nexa.local>"

# --- Payment gateways (sandbox/test only) -----------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Sandbox ----------------------------------------------------------------
# When true, the app runs in DEMO ENVIRONMENT — NO REAL MONEY
SANDBOX_MODE=true

# --- NEXA Intelligence Assistant (OpenRouter AI) ------------------------------
# API key from https://openrouter.ai — used for Phase 9 (AI assistant)
OPENROUTER_API_KEY=
# Model to route through (default: google/gemini-2.0-flash:free)
OPENROUTER_MODEL=google/gemini-2.0-flash:free
# OpenRouter API base URL (optional, defaults to OpenAI-compatible endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1